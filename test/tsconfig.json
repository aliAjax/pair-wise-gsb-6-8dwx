{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "..",
    "outDir": "../.tmp-tests",
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "../src/**/*.tsx", "../test/**/*.ts"]
}
